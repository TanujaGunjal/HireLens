{
  "name": "b2world-ats-backend",
  "version": "1.0.0",
  "description": "Backend for B2World ATS Resume Builder",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --forceExit --detectOpenHandles",
    "test:watch": "jest --watch --forceExit --detectOpenHandles",
    "test:coverage": "jest --coverage --forceExit --detectOpenHandles"
  },
  "keywords": [
    "ats",
    "resume",
    "builder",
    "node",
    "express"
  ],
  "author": "B2World",
  "license": "MIT",
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/__tests__/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "services/atsScoreCalculator.js",
      "services/ats.engine.js",
      "services/atsEngineAdapter.js",
      "services/semantic.service.js",
      "utils/skillGapAnalyzer.js",
      "controllers/authController.js"
    ],
    "coverageReporters": [
      "text",
      "lcov"
    ],
    "testTimeout": 15000,
    "moduleNameMapper": {
      "puppeteer": "<rootDir>/tests/__mocks__/puppeteer.js"
    }
  },
  "dependencies": {
    "@google/genai": "^1.50.1",
    "axios": "^1.15.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "natural": "^6.10.2",
    "pdf-parse": "^2.4.5",
    "puppeteer": "^21.6.1",
    "redis": "^4.6.12",
    "stopword": "^2.0.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
